# ──────────────────────────────────────
# mini-pi 环境变量配置
# 复制此文件为 .env 并填入你的信息:
#   cp .env.example .env
# ──────────────────────────────────────

# 【必填】OpenAI 兼容 API 密钥
# 支持 OpenAI / DeepSeek / 硅基流动等兼容接口
OPENAI_API_KEY=sk-your-api-key-here

# 【可选】API Base URL（默认: https://api.openai.com/v1）
# 使用 DeepSeek 等第三方服务时修改此项
# OPENAI_BASE_URL=https://api.deepseek.com

# 【可选】模型名称（默认: gpt-4o）
# MINI_PI_MODEL=gpt-4o
# MINI_PI_MODEL=deepseek-chat
# MINI_PI_MODEL=claude-sonnet-4-20250514
